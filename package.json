{
  "name": "vue3-math-editor",
  "version": "0.3.3",
  "description": "A semantic equation editor for Vue 3: WYSIWYG equations rendered with KaTeX, exported as Content MathML (CellML-ready), MathJSON and LaTeX.",
  "keywords": [
    "vue",
    "vue3",
    "equation-editor",
    "math",
    "mathml",
    "cellml",
    "katex",
    "latex"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vue3-repos/vue3-math-editor.git"
  },
  "homepage": "https://github.com/vue3-repos/vue3-math-editor#readme",
  "bugs": {
    "url": "https://github.com/vue3-repos/vue3-math-editor/issues"
  },
  "packageManager": "yarn@4.18.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/vue3-math-editor.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue3-math-editor.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-s build:lib build:types",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:types": "vue-tsc -p tsconfig.build.json",
    "build:demo": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:visual": "E2E_VISUAL=1 playwright test --grep @visual",
    "test:e2e:perf": "E2E_PERF=1 playwright test --grep @perf",
    "prerelease": "yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "peerDependencies": {
    "@primeuix/utils": "^0.6.2",
    "katex": "^0.16.0 || ^0.17.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@primeuix/themes": "^2.0.3",
    "@primeuix/utils": "^0.6.2",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.69.0",
    "eslint-plugin-vue": "~10.9.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "libcellml.js": "^0.7.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.69.0",
    "prettier": "3.8.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.38",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.1",
    "vue3-libcellml.js": "^0.7.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
